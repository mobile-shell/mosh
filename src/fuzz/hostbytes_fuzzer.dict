# libFuzzer dictionary for hostbytes_fuzzer: escape-sequence tokens for the
# mosh terminal emulator's host->client display-instruction parser.
esc="\x1b"
csi="\x1b["
osc_start="\x1b]"
osc_bel_end="\x07"
osc_st_end="\x1b\\"
cr="\x0d"
lf="\x0a"
tab="\x09"
backspace="\x08"
bel="\x07"
quest="?"
semicolon=";"
colon_subparam=":"
# CSI finals and common sequences
cursor_home="\x1b[H"
cursor_pos="\x1b[10;20H"
cursor_up="\x1b[3A"
cursor_down="\x1b[2B"
cursor_fwd="\x1b[5C"
cursor_back="\x1b[2D"
sgr_reset="\x1b[0m"
sgr_bold_red="\x1b[1;31m"
sgr_256fg="\x1b[38;5;196m"
sgr_truecolor="\x1b[38:2:10:20:30m"
sgr_reverse="\x1b[7m"
erase_screen="\x1b[2J"
erase_eol="\x1b[K"
erase_line_all="\x1b[2K"
insert_chars="\x1b[3@"
delete_chars="\x1b[2P"
insert_lines="\x1b[2L"
delete_lines="\x1b[3M"
erase_chars="\x1b[4X"
scroll_region="\x1b[5;20r"
reset_scroll_region="\x1b[r"
scroll_up="\x1b[3S"
scroll_down="\x1b[2T"
soft_reset="\x1b[!p"
# DEC private modes
alt_screen_on="\x1b[?1049h"
alt_screen_off="\x1b[?1049l"
cursor_hide="\x1b[?25l"
cursor_show="\x1b[?25h"
autowrap_off="\x1b[?7l"
autowrap_on="\x1b[?7h"
origin_mode_on="\x1b[?6h"
bracketed_paste_on="\x1b[?2004h"
insert_mode_on="\x1b[4h"
# ESC intermediates
save_cursor="\x1b7"
restore_cursor="\x1b8"
index="\x1bD"
reverse_index="\x1bM"
decaln="\x1b#8"
full_reset="\x1bc"
# queries that make the emulator answer on terminal_to_host
device_attrs="\x1b[c"
sec_device_attrs="\x1b[>c"
cursor_pos_report="\x1b[6n"
device_status="\x1b[5n"
# OSC payloads
set_title="\x1b]0;title\x07"
hyperlink_open="\x1b]8;;https://example.com\x07"
hyperlink_close="\x1b]8;;\x07"
clipboard_set="\x1b]52;c;abc\x07"
# wide and combining UTF-8
wide_char="\xe6\xbc\xa2"
combining_acute="e\xcc\x81"
